# Railway supplies PORT automatically. For local development only, use PORT=3000.
PUBLIC_BASE_URL=https://maidthis-meta-followups-production.up.railway.app
MESSAGING_PROVIDER=meta_manual

# Supabase server credentials. Never use the publishable key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=PASTE_A_NEW_SB_SECRET_SERVER_KEY

# Dashboard and internal endpoint protection. Generate a different random value for each.
ADMIN_USER=admin
ADMIN_PASSWORD=PASTE_LONG_RANDOM_ADMIN_PASSWORD
ADMIN_FORM_TOKEN=PASTE_LONG_RANDOM_FORM_TOKEN
INTERNAL_TOKEN=PASTE_LONG_RANDOM_INTERNAL_TOKEN

# Built-in scheduler
INTERNAL_SCHEDULER_ENABLED=true
TICK_INTERVAL_MINUTES=5

# Meta Messenger / Instagram connection
META_APP_SECRET=PASTE_ROTATED_META_APP_SECRET
META_VERIFY_TOKEN=PASTE_LONG_RANDOM_WEBHOOK_VERIFY_TOKEN
META_GRAPH_VERSION=v26.0
TOKEN_ENCRYPTION_KEY=PASTE_EXACTLY_64_HEXADECIMAL_CHARACTERS
PRIVACY_CONTACT_EMAIL=PASTE_REAL_CONTACT_EMAIL

# Existing-history import safety limits
BACKFILL_CONVERSATION_LIMIT=250
BACKFILL_MESSAGES_PER_CONVERSATION=100
