# Application
PORT=3000
PUBLIC_BASE_URL=https://followups.example.com
TIMEZONE=America/Los_Angeles
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_FORM_TOKEN=replace-with-a-second-long-random-value
INTERNAL_TOKEN=replace-with-a-third-long-random-value
INTERNAL_SCHEDULER_ENABLED=true
TICK_INTERVAL_MINUTES=5

# Supabase. Use a new sb_secret_... server key, never the publishable key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Standalone Meta OAuth mode. The dashboard displays a Connect Facebook & Instagram button.
MESSAGING_PROVIDER=meta_oauth
META_APP_ID=replace-with-meta-app-id
META_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
META_APP_SECRET=replace-me
META_GRAPH_VERSION=v23.0
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
PRIVACY_CONTACT_EMAIL=replace-with-your-email
# META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging,instagram_basic,instagram_manage_messages

# Legacy direct-token mode only. Ignored in meta_oauth mode.
# META_PAGE_ACCESS_TOKEN=replace-me
# Optional for multiple Facebook Pages or Instagram business accounts:
# META_ACCESS_TOKENS_JSON={"PAGE_OR_IG_ACCOUNT_ID":"TOKEN"}
# META_BUSINESS_ACCOUNT_ID=replace-with-page-id
# META_PLATFORM=messenger

# Optional HighLevel adapter. Use MESSAGING_PROVIDER=highlevel instead.
# HIGHLEVEL_API_TOKEN=pit-replace-me
# HIGHLEVEL_LOCATION_ID=replace-with-location-id
# HIGHLEVEL_API_VERSION=v3
# HIGHLEVEL_POLL_LIMIT=100

# Existing-history import safety limits
BACKFILL_CONVERSATION_LIMIT=250
BACKFILL_MESSAGES_PER_CONVERSATION=100

# n8n container
N8N_ENCRYPTION_KEY=replace-with-a-fourth-long-random-value
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
FOLLOWUP_APP_URL=http://app:3000
FOLLOWUP_INTERNAL_TOKEN=replace-with-the-same-value-as-INTERNAL_TOKEN
